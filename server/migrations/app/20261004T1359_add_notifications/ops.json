        "description": "create table \"notification\"",
        "sql": "CREATE TABLE \"public\".\"notification\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"dedupeKey\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"message\" text NOT NULL,\n  \"read\" bool DEFAULT false NOT NULL,\n  \"relatedGameId\" int4,\n  \"relatedRequestId\" int4,\n  \"relatedUserId\" int4,\n  \"title\" text NOT NULL,\n  \"type\" text NOT NULL,\n  \"userId\" int4 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"notification_type_check_33091c3c\" CHECK (\"type\" IN ('FRIEND_REQUEST', 'FRIEND_ACCEPTED', 'REMATCH_REQUEST', 'CHALLENGE', 'GAME_RESULT'))\n)",
        "params": []
      }
    ],
