# Copy this file to `.env` and fill in real values.

PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/xiangbattle"

APP_NAME=XiangBattle
CLIENT_URL=http://localhost:5173

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email verification
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
RESEND_VERIFICATION_COOLDOWN_SECONDS=60

# SMTP — leave blank in local dev to log the verification link to the
# server console instead of sending a real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="XiangBattle <no-reply@xiangbattle.local>"

# Cloudinary — avatar uploads (Profile > Edit Profile). Find these under
# your Cloudinary dashboard's "API Environment variable" / Account Details.
# Avatar upload returns a clear error until these are filled in; nothing
# else in the app depends on them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
